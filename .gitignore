# Python virtual environments (local only, never commit)
.venv/
.oci-venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs / temp
*.log
tmp/
temp/

# Hermes persistent project memory — local-only, never commit
# Contains model-independent project state, skills, and checkpoints
.hermes/

# Environment files with secrets — NEVER commit (policy 2026-09-06)
# Real secrets live only on deploy hosts (local portal + Dhargent/Oracle
# Cloud) and are synced with scripts/sync-env-dhargent.sh. The committed
# template is .env.example (blank values).
.env
.env.password
.env.local
.env.*.local
!.env.example

# Agent PID files — tracked (not junk); kept for agent lifecycle reference
# agent.pid

# Generated artifacts (CVs, screenshots, browser captures) — large, ephemeral
generated/

# Dependencies — install from package-lock.json, never commit
node_modules/

# Build output / Python caches
node_modules/
dist/
__pycache__/
*.pyc
