# Python virtual environments (local only, never commit)
.venv/
.oci-venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs / temp
*.log
tmp/
temp/

# Environment files with secrets — committed .env uses *** placeholders only
# (real secrets injected at runtime or in a separate non-tracked .env.local)
.env.local
.env.*.local
# .env.password — tracked (not junk); contains SESSION_PASSWORD

# Agent PID files — tracked (not junk); kept for agent lifecycle reference
# agent.pid

# Generated artifacts (CVs, screenshots, browser captures) — large, ephemeral
generated/

# Dependencies — install from package-lock.json, never commit
node_modules/
