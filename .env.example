# Real-time F&O market-data input (paper trading only)
# Keep the real values in .env or the process environment; never commit them.
# Select fyers (WebSocket) or yahoo (polling fallback). Keep disabled until reviewed.
FNO_MARKET_DATA_PROVIDER=yahoo
FNO_MARKET_DATA_ENABLED=false
# FYERS credentials are only needed when FNO_MARKET_DATA_PROVIDER=fyers.
FYERS_APP_ID=
# FYERS_ACCESS_TOKEN/FYERS_REFRESH_TOKEN are LEGACY fallbacks. The token model
# (2026-09-08): /auth/fyers/login stores ONE encrypted row in fyers_tokens and
# runtime reads it from the DB — .env tokens are only used when no DB row yet.
FYERS_ACCESS_TOKEN=
# Comma-separated FYERS symbols. Add exact current underlying/option symbols.
FNO_MARKET_DATA_SYMBOLS=NSE:NIFTY50-INDEX,NSE:NIFTYBANK-INDEX,NSE:SENSEX-INDEX
# Yahoo chart symbols optionally map to the app's instrument names with `symbol=instrument`.
# Defaults are liquid F&O underlyings/proxies; Yahoo is not an option-chain source.
YAHOO_FINANCE_SYMBOLS=^NSEI=NSE:NIFTY50-INDEX,^NSEBANK=NSE:NIFTYBANK-INDEX,^BSESN=NSE:SENSEX-INDEX
YAHOO_FINANCE_POLL_MS=15000
YAHOO_FINANCE_TIMEOUT_MS=10000
YAHOO_FINANCE_RANGE=1d
YAHOO_FINANCE_INTERVAL=1m
# Optional explicit option metadata for FYERS ticks. No symbol parsing is guessed.
# Example: [{"symbol":"NSE:NIFTY26SEP25000CE","underlying":"NIFTY","expiry":"2026-09-24","strike":25000,"optionType":"CE","lotSize":65,"tickSize":0.05}]
FNO_OPTION_CONTRACTS=
# Minimum interval between persisted snapshots per symbol.
FNO_MARKET_DATA_PERSIST_MS=1000

# --- Added 2026-09-06: local keys not previously in template (set real values at deploy) ---
SESSION_NAME=
RECOVERY_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
APP_SECRET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_KEY=
FYERS_APP_SECRET=
FYERS_REDIRECT_URI=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
TINYFISH_API_KEY=
FYERS_REFRESH_TOKEN= # legacy fallback only — see FYERS_ACCESS_TOKEN note above
ENCRYPTION_KEY=
UPSTOX_SANDBOX_ENABLED=
UPSTOX_SANDBOX_MODE=
UPSTOX_SANDBOX_BASE_URL=
UPSTOX_SANDBOX_CLIENT_ID=
UPSTOX_SANDBOX_CLIENT_SECRET=
UPSTOX_SANDBOX_ACCESS_TOKEN=
# ── Upstox LIVE market data (data source only — module stays PAPER) ───────────
# Universe to ingest: comma-separated Upstox v2 instrument keys.
# Expiry is never configured: the nearest LISTED expiry is used (today's on
# expiry day), read from the broker's own /option/contract list.
# e.g. today's SENSEX expiry:  UPSTOX_LIVE_INSTRUMENTS=BSE_INDEX|SENSEX
UPSTOX_LIVE_INSTRUMENTS=
UPSTOX_LIVE_PREFER_TODAY_EXPIRY=true
UPSTOX_LIVE_STRIKE_WINDOW=10
UPSTOX_LIVE_POLL_MS=30000
UPSTOX_LIVE_API_KEY=
UPSTOX_LIVE_API_SECRET=
UPSTOX_LIVE_ACCESS_TOKEN=
UPSTOX_LIVE_REDIRECT_URI=https://<host>/api/upstox/callback
AWS_REGION=
HERMES_BEDROCK_MODEL_ID=
AWS_PROFILE=
HERMES_AI_TEST_TOKEN=

# ─── Upstox PAPER capital + UPSTOX_AUTO_PAPER_ENTRY_V1 (configurable, no code change) ───
# Default capital for a NEW paper account. Each account stores its own capital
# (change at runtime: POST /upstox-live-paper/portfolios/:id/capital).
UPSTOX_LIVE_PAPER_CAPITAL=5000
# Risk envelope — every limit is a percentage of the CONFIGURED capital, or (in
# ACCOUNT_BALANCE_PCT mode) of the current real account balance at execution.
UPSTOX_RISK_MODE=FIXED_CAPITAL
UPSTOX_RISK_MAX_TRADE_PCT=1
UPSTOX_RISK_MAX_LOSS_PCT=10
UPSTOX_RISK_MAX_DRAWDOWN_PCT=20
UPSTOX_RISK_MAX_POSITIONS=1
UPSTOX_RISK_MAX_LOTS=1
UPSTOX_RISK_MIN_RR=1.5
# REAL mode is NOT activated: interface only. Exposure ceiling as a % of the
# current real account balance, used only when UPSTOX_RISK_MODE=ACCOUNT_BALANCE_PCT.
UPSTOX_RISK_BALANCE_PCT=25
# UPSTOX_AUTO_PAPER_ENTRY_V1 thresholds — the operator's thresholds; they are
# deliberately not loosened to manufacture trades. No averaging down is a policy
# constant, not a toggle.
UPSTOX_V1_MIN_CONFIDENCE=0.65
UPSTOX_V1_MIN_REVERSAL_SCORE=0.60
UPSTOX_V1_MIN_REWARD_RISK=1.5
UPSTOX_V1_MAX_EXTENSION_ATR=2
UPSTOX_V1_STOP_ATR_BUFFER=0.5
UPSTOX_V1_TARGET_ATR_MULTIPLE=2.5
UPSTOX_V1_TRAIL_ATR_MULTIPLE=2
UPSTOX_V1_TRAIL_STRUCTURE_BARS=3
UPSTOX_V1_PARTIAL_ENABLED=false
UPSTOX_V1_PARTIAL_AT_ATR=2
UPSTOX_V1_PARTIAL_FRACTION=0.5
UPSTOX_V1_EXPIRY_DAY_TIME_STOP=true
UPSTOX_V1_EXPIRY_DAY_TIME_STOP_MINUTES=915
UPSTOX_V1_ENTRY_START_MINUTES=555
UPSTOX_V1_ENTRY_END_MINUTES=920
UPSTOX_V1_ATM_WINDOW=0
UPSTOX_V1_MAX_LOTS=1
UPSTOX_V1_MAX_POSITIONS=1
UPSTOX_V1_MAX_SPREAD_PCT=0.02
UPSTOX_V1_MIN_TOP_DEPTH=1
UPSTOX_V1_MAX_TICK_AGE_MS=15000
# Loop cadence (runs 09:15–15:30 IST only).
UPSTOX_AUTO_PAPER_ENTRY_ENABLED=true
UPSTOX_AUTO_PAPER_INTERVAL_SEC=30
UPSTOX_AUTO_PAPER_LOOKBACK_MIN=240
