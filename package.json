{
  "name": "my-job-agent",
  "version": "0.1.0",
  "description": "Autonomous job-search agent for Swarna Sekhar Dhar — lead scouting, profile completeness, assisted auto-apply",
  "private": true,
  "scripts": {
    "build": "nest build",
    "test:trading": "npm run build && node scripts/yahoo-finance-parser.test.js && node scripts/market-data-filter.test.js && node scripts/option-chain-parser.test.js && node scripts/market-feed-guard.test.js && node scripts/feed-health-gate.test.js && node scripts/yahoo-disable.test.js && node scripts/unified-market-data.test.js",
    "test:ai": "npm run build && node scripts/ai-bedrock-provider.test.js && node scripts/ai-auth.test.js",
    "test:trading-ai": "npm run build && node scripts/trading-ai.test.js",
    "test:upstox-live-paper": "npm run build && node scripts/upstox-live-paper.test.js",
    "test:upstox-token": "npm run build && node scripts/upstox-token-oauth.test.js",
    "test:gate-exemptions": "node scripts/gate-exemptions.test.js",
    "test:pattern": "npm run build && node scripts/feed-arbitration.test.js && node scripts/pattern-engine.test.js",
    "test:pre-open": "npm run build && node scripts/pre-open-capture.test.js && node scripts/pre-open-oai-series.test.js",
    "test:precleared": "npm run build && node scripts/upstox-live-paper-instructions.test.js",
    "test:clarifications": "npm run build && node scripts/verify-clarifications.js",
    "test:desks": "npm run build && node scripts/upstox-live-paper.test.js && node scripts/upstox-live-paper-instructions.test.js && node scripts/feed-arbitration.test.js && node scripts/fnf-shared-quote-fallback.test.js && node scripts/pattern-engine.test.js",
    "test:feed-beat": "npm run build && node scripts/feed-beat-liveness.test.js",
    "test:db-pool": "npm run build && node scripts/db-pool-reliability.test.js",
    "test:lease-connection": "npm run build && node scripts/lease-connection.test.js",
    "test:canonical-ticks": "npm run build && node scripts/canonical-tick-interpreter.test.js",
    "test:labels": "npm run build && node scripts/label-integrity.test.js",
    "test:imap": "npm run build && node scripts/imap-safety.test.js",
    "test:alignment": "npm run build && node scripts/pre-open-alignment.test.js",
    "verify:alignment": "node scripts/pre-open-alignment-replay.js",
    "test:gap-taxonomy": "npm run build && node scripts/gap-taxonomy.test.js",
    "verify:gap-taxonomy": "node scripts/gap-taxonomy-replay.js",
    "test:gap-hypotheses": "npm run build && node scripts/gap-hypotheses.test.js",
    "verify:gap-hypotheses": "node scripts/gap-hypotheses-replay.js",
    "verify:canonical-live": "node scripts/canonical-live-verify.js",
    "verify:failover": "node scripts/feed-failover-verify.js",
    "market-data:canonical": "node scripts/market-data-canonical-status.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test:learning": "node scripts/option-trade-learning.js --selfcheck",
    "test:entry-policy": "node scripts/entry-policy.test.js",
    "gate:status": "node scripts/gate-status.js",
    "gate:check": "node scripts/gate-close-check.js",
    "gate:hooks:install": "chmod +x scripts/hooks/pre-push && git config core.hooksPath scripts/hooks && echo 'gate-close pre-push guard installed (core.hooksPath=scripts/hooks)'"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1127.0",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/express-session": "^1.19.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "astronomy-engine": "^2.1.19",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^7.0.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "fyers-api-v3": "^2.1.0",
    "helmet": "^8.3.0",
    "imapflow": "^1.7.6",
    "mailparser": "^3.9.16",
    "mysql2": "^3.11.0",
    "node-rsa": "^2.0.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.20.1",
    "playwright-core": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
