{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      { "include": "project-status/*.json", "watchAssets": true },
      { "include": "job-application-roadmap/*.json", "watchAssets": true }
    ],
    "deleteOutDir": true
  }
}
